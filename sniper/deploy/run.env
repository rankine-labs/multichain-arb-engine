# ============================================================================
# SNIPER RUN SETTINGS (read by deploy/sniper-cron.sh on the server)
#
# Plain English:
#   This file decides what the sniper runs on the server. Change it here in
#   GitHub, the build publishes it, and within ~2 minutes the server restarts
#   the sniper with the new settings. Nobody needs to open a terminal.
#
#   SNIPER_ENABLED=0 stops everything (kill switch). 1 runs it.
#   SNIPER_MODE lists the programs to run (paper, feed-watch).
#   SNIPER_OUT_<MODE> sets that program's output folder (else SNIPER_OUT).
#   The sniper is PAPER ONLY: it holds no keys and cannot send transactions.
#   Only simple KEY=VALUE lines starting with SNIPER_ are used.
# ============================================================================
SNIPER_ENABLED=1
SNIPER_MODE=paper feed-watch
SNIPER_OUT=paper-out/run3
SNIPER_OUT_FEED_WATCH=feed-out/run1
SNIPER_TP_PCT=5
SNIPER_SL_PCT=10
SNIPER_HOLD_SECS=60
# 1 = paper trader uses the paid Chainstack node (only while the arb bot is paused)
SNIPER_USE_CHAINSTACK=1
