# Dependencies (installed on each machine, never committed)
node_modules/

# Secrets - API keys, wallet keys, Telegram tokens. NEVER commit these.
.env
.env.*

# Build / test output
.test-build/

# Auto-deploy logs and lock (server only)
deploy/*.log
deploy/*.lock
# Foundry build output
contracts/out/
contracts/cache/
.scripts-build/

# Bot state files (server only): chain-wide pool scan cache
data/

# Compiled bot (built on the server by auto-deploy)
dist/
